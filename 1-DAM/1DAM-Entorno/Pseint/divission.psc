Algoritmo divission
	
	Definir num1, num2 Como Entero
	Definir division Como Real
	
	Escribir "Escribe un número: "
	Leer num1
	Escribir "Escribe otro número: "
	Leer num2
	
	Si num2 <> 0 Entonces
		division <- num1 / num2
		Escribir "El resultado es ", division
	SiNo
		Escribir "No se puede dividir entre cero."
	Fin Si
	
FinAlgoritmo
