<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <ListView
        android:id="@+id/miLista"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/miTexto1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="#000000" />

    <TextView
        android:id="@+id/miTexto2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="#757575" />

    <ImageView
        android:id="@+id/miImagen"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:contentDescription="Imagen del elemento"
        android:scaleType="centerCrop"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/miEnlace"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Visitar Google"
        android:textColor="#0000FF"
        android:textSize="14sp"
        android:layout_marginTop="8dp" />

    <CheckBox
        android:id="@+id/miCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seleccionar opción"
        android:layout_marginTop="8dp" />

    <RadioButton
        android:id="@+id/miRadioButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Opción única"
        android:layout_marginTop="8dp" />

</LinearLayout>
